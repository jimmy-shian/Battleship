{
  "name": "battleship-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "海戰棋 — 單機版 + Cloudflare Workers 免費雲端多人連線",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "npm run sync && wrangler dev",
    "deploy": "npm run sync && wrangler deploy",
    "tail": "wrangler tail",
    "check": "npm run sync && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
